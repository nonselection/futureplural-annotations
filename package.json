{
    "name": "futureplural-annotations",
    "version": "0.1.0",
    "description": "Annotate text and add tags in Reading View.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "predeploy": "npm run build",
        "deploy": "node --env-file-if-exists=.env.local scripts/deploy.mjs",
        "predeploy:actual": "npm run build",
        "deploy:actual": "node --env-file-if-exists=.env.local scripts/deploy.mjs --actual",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests scripts *.mjs package.json manifest.json",
        "format": "prettier --write \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\" \"scripts/**/*.mjs\" \"*.{json,md,mjs}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\" \"scripts/**/*.mjs\" \"*.{json,md,mjs}\""
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin"
    ],
    "author": "nonselection",
    "license": "MIT",
    "optionalDependencies": {
        "@esbuild/darwin-x64": "^0.28.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@eslint/json": "^0.14.0",
        "@types/node": "^20.19.39",
        "@typescript-eslint/parser": "^8.62.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "globals": "^17.0.0",
        "jsdom": "^30.0.1",
        "obsidian": "^1.13.1",
        "prettier": "^3.8.3",
        "tslib": "2.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vitest": "^4.1.4"
    },
    "overrides": {
        "ajv": "6.14.0",
        "brace-expansion": "1.1.13",
        "flatted": "3.4.2",
        "minimatch": "3.1.4"
    },
    "dependencies": {
        "rough-notation": "0.5.1"
    }
}
